// tests/fixtures/vale/riscv_sample_crypto.vaf
// Minimal Project Everest Vale verified specification for RISC-V 64-bit (rv64gc + Zk crypto).
// Exercises RV64I base registers, Zbb bitmanipulation, and Zk scalar AES/SHA acceleration.
module Riscv_Sample_Crypto

#verbatim{:interface}
module Map = FStar.Map
let map = Map.t
let (.[]) = Map.sel
let (.[]<-) = Map.upd

type register =
  | X0 | RA | SP | GP | TP | T0 | T1 | T2
  | S0 | S1 | A0 | A1 | A2 | A3 | A4 | A5
  | A6 | A7 | S2 | S3 | S4 | S5 | S6 | S7
  | S8 | S9 | S10 | S11 | T3 | T4 | T5 | T6

type ins =
  | IAdd       : dst:register -> s1:register -> s2:register -> ins
  | IAddi      : dst:register -> src:register -> imm:int -> ins
  | ISub       : dst:register -> s1:register -> s2:register -> ins
  | IXor       : dst:register -> s1:register -> s2:register -> ins
  | IAnd       : dst:register -> s1:register -> s2:register -> ins
  | IOr        : dst:register -> s1:register -> s2:register -> ins
  | IRev8      : dst:register -> src:register -> ins
  | IRor       : dst:register -> s1:register -> s2:register -> ins
  | IRol       : dst:register -> s1:register -> s2:register -> ins
  | IAes64es   : dst:register -> s1:register -> s2:register -> ins
  | IAes64esm  : dst:register -> s1:register -> s2:register -> ins
  | IAes64ds   : dst:register -> s1:register -> s2:register -> ins
  | IAes64dsm  : dst:register -> s1:register -> s2:register -> ins
  | ISha256sum0: dst:register -> src:register -> ins
  | ISha256sum1: dst:register -> src:register -> ins
  | ISha512sum0: dst:register -> src:register -> ins
  | ISha512sum1: dst:register -> src:register -> ins

type ocmp = | OPlaceholder : int -> ocmp
type va_code =
  | Ins : ins:ins -> va_code
  | Block : block:va_codes -> va_code
  | IfElse : ifCond:ocmp -> ifTrue:va_code -> ifFalse:va_code -> va_code
  | While : whileCond:ocmp -> whileBody:va_code -> va_code
and va_codes = list va_code

type va_pbool = unit
let va_ttrue () = ()
let va_ffalse (s:string) = ()
let va_pbool_and x y = ()

let va_CNil () = []
let va_CCons x y = x::y
let va_Block (block:va_codes) : Tot va_code = Block block
let va_IfElse (ifCond:ocmp) (ifTrue:va_code) (ifFalse:va_code) : va_code = IfElse ifCond ifTrue ifFalse
let va_While (whileCond:ocmp) (whileBody:va_code) : va_code = While whileCond whileBody
let va_get_block (c:va_code{Block? c}) : GTot va_codes = Block?.block c

type va_state = map register int
let va_get_ok (s:va_state) : GTot prop = True
let va_get_reg (r:register) (s:va_state) : GTot int = s.[r]
let va_update_ok (sM:va_state) (sK:va_state) : GTot va_state = sK
let va_update_reg (r:register) (sM:va_state) (sK:va_state) : GTot va_state = sK.[r] <- sM.[r]

type va_operand_reg = register
let va_op_reg_reg (r:register) : Tot register = r
let va_is_src_reg (r:register) (s:va_state) = True
let va_is_dst_reg (r:register) (s:va_state) = True
let va_update_operand_reg (r:register) (sM:va_state) (sK:va_state) : GTot va_state = va_update_reg r sM sK
let va_eval_reg (s:va_state) (r:register) : GTot int = s.[r]

type cmp_operand = register
let va_op_cmp_reg (r:register) : cmp_operand = r

let va_state_eq (s0:va_state) (s1:va_state) : prop = True
type va_fuel = int
let eval_code (c:va_code) (s0:va_state) (f0:va_fuel) (sN:va_state) : prop = True

unfold let va_hd = Cons?.hd
unfold let va_tl = Cons?.tl
let va_reveal_opaque (s:string) = norm_spec [zeta; delta_only [s]]
let va_require_total (b0:va_code) (c:va_code) (s0:va_state) : prop = b0 == c
let va_ensure_total (b0:va_code) (s0:va_state) (s1:va_state) (f1:va_fuel) : prop = eval_code b0 s0 f1 s1

val va_eval_ins : c:va_code -> s0:va_state -> Tot (va_state & va_fuel)
val va_ins_lemma : c:va_code -> s0:va_state -> Lemma (requires True) (ensures True)

let va_lemma_empty_total (s0:va_state) (bN:va_codes) : Ghost (va_state & va_fuel)
  (requires True)
  (ensures (fun p -> fst p == s0 /\ eval_code (Block []) s0 (snd p) s0))
  = (s0, 0)

let va_lemma_merge_total (b0:va_codes) (s0:va_state) (f0:va_fuel) (sM:va_state) (fM:va_fuel) (sN:va_state) : Ghost (va_fuel)
  (requires Cons? b0 /\ eval_code (Cons?.hd b0) s0 f0 sM /\ eval_code (Block (Cons?.tl b0)) sM fM sN)
  (ensures (fun fN -> eval_code (Block b0) s0 fN sN))
  = f0 + fM
#endverbatim

#verbatim
let va_eval_ins c s0 = (s0, 1)
let va_ins_lemma c s0 = ()
#endverbatim

var ok:bool {:state ok()};
var a0:int {:state reg(A0)};
var a1:int {:state reg(A1)};
var a2:int {:state reg(A2)};
var a3:int {:state reg(A3)};
var t0:int {:state reg(T0)};
var t1:int {:state reg(T1)};

operand_type reg:int := inout a0 | inout a1 | inout a2 | inout a3 | inout t0 | inout t1;

procedure Add(out dst:reg, in s1:reg, in s2:reg)
    {:instruction Ins(IAdd(dst, s1, s2))}
{ assume false; }

procedure Addi(out dst:reg, in src:reg, inline imm:int)
    {:instruction Ins(IAddi(dst, src, imm))}
{ assume false; }

procedure Sub(out dst:reg, in s1:reg, in s2:reg)
    {:instruction Ins(ISub(dst, s1, s2))}
{ assume false; }

procedure Xor(out dst:reg, in s1:reg, in s2:reg)
    {:instruction Ins(IXor(dst, s1, s2))}
{ assume false; }

procedure Rev8(out dst:reg, in src:reg)
    {:instruction Ins(IRev8(dst, src))}
{ assume false; }

procedure Aes64esm(out dst:reg, in s1:reg, in s2:reg)
    {:instruction Ins(IAes64esm(dst, s1, s2))}
{ assume false; }

procedure Aes64dsm(out dst:reg, in s1:reg, in s2:reg)
    {:instruction Ins(IAes64dsm(dst, s1, s2))}
{ assume false; }

procedure Sha256sum0(out dst:reg, in src:reg)
    {:instruction Ins(ISha256sum0(dst, src))}
{ assume false; }

procedure Sha256sum1(out dst:reg, in src:reg)
    {:instruction Ins(ISha256sum1(dst, src))}
{ assume false; }

// RISC-V 64-bit sample verified crypto procedure combining RV64I, Zbb rev8, Zk scalar AES & SHA-256
procedure Riscv_Sample_CryptoRound()
    modifies
        a0; a1; a2; a3;
        t0; t1;
{
    Addi(a0, a0, 42);
    Add(a1, a1, a2);
    Sub(a2, a2, a3);
    Rev8(t0, a1);
    Sha256sum0(t1, t0);
    Aes64esm(a0, a1, a2);
    Aes64dsm(a2, a3, t0);
    Xor(a0, a0, t1);
}
